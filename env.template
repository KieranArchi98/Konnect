# Supabase Configuration
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# JWT Secret (generate a random string, e.g., using: openssl rand -hex 32)
JWT_SECRET=your-secret-key-here-change-this

# News API (optional - get from https://newsapi.org/)
NEWS_API_KEY=your-news-api-key

# Pinecone Configuration (for vector storage)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENV=your-pinecone-environment
PINECONE_INDEX=your-pinecone-index-name

# OpenAI API Key (for LLM features)
OPENAI_API_KEY=your-openai-api-key

# Gmail Configuration (optional - for email features)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_USE_APP_PASSWORD=false
GMAIL_APP_PASSWORD=
