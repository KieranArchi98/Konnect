{
  "name": "agent-dashboard-business",
  "version": "1.0.0",
  "description": "Agent Dashboard Business Application",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "powershell -Command \"cd backend; .\\venv\\Scripts\\Activate.ps1; uvicorn app.main:app --reload --host 0.0.0.0 --port 8000\"",
    "install:all": "npm install && cd frontend && npm install",
    "build": "cd frontend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "cd frontend && npm run preview",
    "start:backend": "powershell -Command \"cd backend; .\\venv\\Scripts\\Activate.ps1; uvicorn app.main:app --host 0.0.0.0 --port 8000\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["agent", "dashboard", "business", "react", "fastapi"],
  "author": "Your Name",
  "license": "MIT"
} 